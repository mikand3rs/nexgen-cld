# NexGen CLD — example environment. Copy to .env and fill in your own
# values. NEVER put a real password in this example file, and never
# commit .env. The previous .env.example in this repo contained a
# 36-character password value — treat that value as exposed and
# rotate POSTGRES_PASSWORD if it was ever used for a real database.
POSTGRES_DB=nexgen
POSTGRES_USER=nexgen
POSTGRES_PASSWORD=change-me-to-a-new-password
LEMONADE_BASE_URL=http://172.25.160.1:13305/v1
LEMONADE_MODEL=Qwen3.5-2B-GGUF
