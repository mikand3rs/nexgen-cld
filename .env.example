# BMOS 3.2 — copy to .env and fill in. Never commit .env.
#
# Database PASSWORDS are NOT here anymore (Phase 2): they live in
# secrets/postgres_password.txt, secrets/app_password.txt and
# secrets/migrator_password.txt (chmod 700 dir, chmod 600 files, gitignored).
# This file keeps only non-secret settings.
POSTGRES_DB=bmos
POSTGRES_USER=bmos
HOST_UID=1000
HOST_GID=1000

# Phase 6 — Qdrant (derived vector index; PostgreSQL stays authoritative).
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bmos_chunks
# Vector dimension MUST match the embedding model output. 384 is the demo
# default (DemoEmbeddings). Do not hardcode 1536 until a real model is chosen.
QDRANT_VECTOR_SIZE=384

# Phase 7 — Garage (S3-compatible object storage; PG stays authoritative).
# The endpoint is only reachable inside the backend network. Clients use
# presigned URLs minted by PHP, never direct Garage access.
S3_BUCKET=bmos-objects

# Phase 8 — Lemonade (Windows host, GPU). Docker Desktop resolves
# host.docker.internal to the Windows host. Override only if that fails:
# LEMONADE_URL=http://172.25.160.1:13305  (verify with `ip route` in WSL)
# LEMONADE_MODEL=Qwen3.5-2B-GGUF

# Phase 17 — AI provider abstraction. One variable selects the backend:
#   AI_PROVIDER=lemonade   (default; local, no key)
#   AI_PROVIDER=mistral    (needs MISTRAL_API_KEY; ~1B tokens/mo free tier exists,
#                           but free tier trains on prompts — paid tier does not)
#   AI_PROVIDER=deepseek   (needs DEEPSEEK_API_KEY; cheapest paid, ~$0.15-0.60/M)
#   AI_PROVIDER=openai     (needs OPENAI_API_KEY)
#   AI_PROVIDER=groq       (needs GROQ_API_KEY; fastest)
#   AI_PROVIDER=ollama     (needs OLLAMA_URL + OLLAMA_MODEL; remote Ollama incl. Cloud Run GPU)
#   AI_PROVIDER=custom     (needs AI_API_URL + AI_MODEL; any OpenAI-compatible endpoint)
# Keys can come from env or a Docker secret file: MISTRAL_API_KEY_FILE=/run/secrets/mistral_api_key
# Model IDs change over time — override per provider, e.g. MISTRAL_MODEL=mistral-large-latest
# See docs/ai-providers.md for the full comparison and setup guide.
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# Phase 10 (optional) — n8n Queue Mode. Uncomment to enable (requires
# --profile n8n --profile queue):
# N8N_EXECUTIONS_MODE=queue
# N8N_REDIS_HOST=redis
